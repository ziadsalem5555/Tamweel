# Django Core Settings
SECRET_KEY=django-insecure-crowdfunding-egypt-demo-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database (defaults to db.sqlite3 if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/crowdfunding_db

# ----------------------------------------------------
# Gmail SMTP Configuration for Account Activation
# ----------------------------------------------------
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate a 16-character "App Password" at: https://myaccount.google.com/apppasswords
# 3. Paste your full Gmail address and 16-character app password below:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=CrowdFund Egypt <your_email@gmail.com>

# ----------------------------------------------------
# Meta / Facebook OAuth Login (Bonus Requirement)
# ----------------------------------------------------
# 1. Create a Facebook App at: https://developers.facebook.com/apps/
# 2. Add "Facebook Login for Business / Web"
# 3. Add Valid OAuth Redirect URI: http://127.0.0.1:8000/accounts/facebook/callback/
# 4. Copy your App ID and App Secret:
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/accounts/facebook/callback/

# ----------------------------------------------------
# Google Gemini API Configuration (Tamweel AI Chatbot)
# ----------------------------------------------------
# 1. Get your Gemini API key at: https://aistudio.google.com/app/apikey
# 2. Paste your Gemini API key below (backend only, never expose to frontend):
GEMINI_API_KEY=
