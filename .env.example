# Django Settings
SECRET_KEY=django-insecure-crowdfunding-egypt-demo-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (optional DATABASE_URL, defaults to SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/crowdfunding_db

# Email Configuration
# Set EMAIL_BACKEND to 'django.core.mail.backends.smtp.EmailBackend' for production SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=CrowdFund Egypt <noreply@crowdfundegypt.com>
